    "title": "[PERF] Fix excessive parquet metadata reading",
    "user": {
      "login": "synchromic",
      "id": 32619800,
      "node_id": "MDQ6VXNlcjMyNjE5ODAw",
      "avatar_url": "https://avatars.githubusercontent.com/u/32619800?v=4",
      "gravatar_id": "",
      "url": "https://api.github.com/users/synchromic",
      "html_url": "https://github.com/synchromic",
      "followers_url": "https://api.github.com/users/synchromic/followers",
      "following_url": "https://api.github.com/users/synchromic/following{/other_user}",
      "gists_url": "https://api.github.com/users/synchromic/gists{/gist_id}",
